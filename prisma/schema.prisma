generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  QA
  ACCOUNT
  DIRECTOR
  SUPERVISOR
  PURCHASER
  SR_ENGINEER
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CONFLICT
  COMPLETED
}

enum StageName {
  QA
  ACCOUNT
  PURCHASER
  SUPERVISOR
  RECEIVING
}

enum MessageType {
  TEXT
  MEDIA
  AUDIO
  FILE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DELAY
  COMPLETE
  DISCARDED
}

model User {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String
  cnic              String
  gender            String
  number            String
  role              Role
  purchaserAllProducts Boolean         @default(false)
  status            String
  alreadyAssigned   Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isEdit            Boolean            @default(false)
  updatedSites      Site[]             @relation("UpdatedByUser")
  createdGroups     ChatGroup[]        @relation("UserCreatedGroups")
  chatMemberships   ChatMember[]
  messages          Message[]
  ChatGroup         ChatGroup[]
  userNotifications Notification[]
  requestStages     RequestStage[]
  siteSupervisors   SiteSupervisor[]
  sitePurchasers    SitePurchaser[]
  siteSeniorEngineers SiteSeniorEngineer[]
  purchaserProducts  UserProduct[]
  subscriptions     PushSubscription[]
  createdTasks      Task[]             @relation("TaskCreatedBy")
  updatedTasks      Task[]             @relation("TaskUpdatedBy")
  taskLogs          TaskLog[]          @relation("TaskLogActor")
}

model Site {
  id             Int              @id @default(autoincrement())
  name           String
  address        String
  client_name    String
  city           String
  province       String
  plot_size      String
  status         String
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  updated_by     Int?
  updatedByUser  User?            @relation("UpdatedByUser", fields: [updated_by], references: [id])
  currentStage   String           @default("")
  locationUrl    String?
  coveredArea    String?
  marketingPersonName  String?
  marketingPersonPhone String?
  startDate      DateTime?
  endDate        DateTime?
  requests       Request[]
  materialTotal  MaterialTotal?
  stageMaterial  StageMaterial?
  Product        Product?         @relation(fields: [productId], references: [id])
  productId      Int?
  extraMaterial  ExtraMaterial[]
  supervisors    SiteSupervisor[]
  purchasers     SitePurchaser[]
  seniorEngineers SiteSeniorEngineer[]
  contractorData ContractorData?
  agreementData AgreementData[]
  dailyUpdates   DailyMaterialUpdate[]
  dailyIssues    DailyIssueUpdate[]
  dailySiteProgress DailySiteProgressUpdate[]
}

model DailyMaterialUpdate {
  id        Int      @id @default(autoincrement())
  siteId    Int
  date      DateTime
  rows      Json     @default("[]")
  createdBy Int?
  createdByName String?
  updatedBy Int?
  updatedByName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
  @@index([siteId, date])
}

model DailyIssueUpdate {
  id            Int      @id @default(autoincrement())
  siteId        Int
  date          DateTime
  rows          Json     @default("[]")
  createdBy     Int?
  createdByName String?
  updatedBy     Int?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
  @@index([siteId, date])
}

model DailySiteProgressUpdate {
  id            Int      @id @default(autoincrement())
  siteId        Int
  date          DateTime
  stage         String   @default("")
  workSummary   String   @default("")
  createdBy     Int?
  createdByName String?
  updatedBy     Int?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
  @@index([siteId, date])
}

model ContractorData {
  id        Int      @id @default(autoincrement())
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  siteId    Int      @unique
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model AgreementData {
  id        Int      @id @default(autoincrement())
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

model Request {
  id            Int           @id @default(autoincrement())
  siteRequestId Int           @default(0)
  qty           Float
  stageWiseQty  Json?
  steelItes     Json?
  sanitaryImage Json?
  priority      String        @default("medium")
  releasedQty   Float?
  receivedQty   Float?        @default(0)
  status        RequestStatus @default(PENDING)
  siteId        Int
  stageName     StageName?
  site          Site          @relation(fields: [siteId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  productId     Int
  product       Product       @relation(fields: [productId], references: [id])
  stages        RequestStage[]

  @@index([siteId, createdAt])
  @@index([siteId, status])
  @@index([siteId, stageName])
  @@index([productId, createdAt])
  @@index([siteId, updatedAt])
  @@index([status, updatedAt])
}

model RequestImage {
  id        Int      @id @default(autoincrement())
  fileName  String
  mimeType  String   @default("image/webp")
  size      Int      @default(0)
  data      Bytes
  createdAt DateTime @default(now())
  stages    RequestStage[]
}

model RequestStage {
  id         Int       @id @default(autoincrement())
  requestId  Int
  stageName  StageName
  status     String
  comment    String?
  userId     Int
  stageImageId Int?
  receivedAt DateTime?
  forwardAt  DateTime?

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
  stageImage RequestImage? @relation(fields: [stageImageId], references: [id])

  @@index([requestId])
  @@index([stageName, status])
  @@index([userId, status])
  @@index([stageImageId])
  @@unique([requestId, stageName])
}

model MaterialTotal {
  id        Int      @id @default(autoincrement())
  data      Json
  file_name String   @default("File")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  siteId    Int      @unique
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model StageMaterial {
  id        Int      @id @default(autoincrement())
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  siteId    Int      @unique
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model ChatMember {
  id         Int       @id @default(autoincrement())
  userId     Int
  groupId    Int
  joinedAt   DateTime  @default(now())
  lastSeenAt DateTime?
  user       User      @relation(fields: [userId], references: [id])
  group      ChatGroup @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model Message {
  id            Int         @id @default(autoincrement())
  content       String?
  type          MessageType @default(TEXT)
  mediaUrl      String?
  audioDuration Int?
  audioData     Bytes?
  fileData      Bytes?
  fileName      String?
  mimeType      String?
  senderId      Int
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  groupId       Int
  group         ChatGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model ChatGroup {
  id          Int          @id @default(autoincrement())
  name        String
  createdById Int
  createdBy   User         @relation("UserCreatedGroups", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  members     ChatMember[]
  messages    Message[]
  User        User?        @relation(fields: [userId], references: [id])
  userId      Int?
  lastMessage String       @default("")
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())
  userId    Int?
  User      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([userId, type, createdAt])
  @@index([userId, type, title, createdAt])
  @@index([type, title])
}

model Product {
  id            Int             @id @default(autoincrement())
  unit          String
  name          String
  requests      Request[]
  site          Site[]
  extraMaterial ExtraMaterial[]
  purchaserUsers UserProduct[]
  stageItems    StageItem[]
}

model Stage {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     StageItem[]
}

model StageItem {
  id        Int      @id @default(autoincrement())
  stageId   Int
  productId Int
  qty       Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stage   Stage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model UserProduct {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model ExtraMaterial {
  id           Int      @id @default(autoincrement())
  siteId       Int
  productId    Int
  purchase_qty Float    @default(0)
  rate         Float?
  amount       Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site    Site    @relation(fields: [siteId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model SiteSupervisor {
  id     Int @id @default(autoincrement())
  siteId Int
  userId Int

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
}

model SitePurchaser {
  id     Int @id @default(autoincrement())
  siteId Int
  userId Int
  status String @default("active")
  allProducts Boolean @default(false)
  productIds Int[] @default([])

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
}

model SiteSeniorEngineer {
  id     Int @id @default(autoincrement())
  siteId Int
  userId Int

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
}

model PushSubscription {
  id         Int      @id @default(autoincrement())
  userId     Int
  endpoint   String   @unique
  p256dh     String
  auth       String
  deviceType String?  // mobile | tablet | desktop
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  assigned_to String?
  contractor  String?
  penalty     Float?
  due_date    DateTime?
  site_id     Int?
  status      TaskStatus @default(TODO)
  created_by  Int?
  created_at  DateTime   @default(now())
  updated_by  Int?
  updated_at  DateTime   @updatedAt

  createdByUser User?     @relation("TaskCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updatedByUser User?     @relation("TaskUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)
  logs          TaskLog[]

  @@index([status])
  @@index([due_date])
  @@index([site_id])
}

model TaskLog {
  id         Int      @id @default(autoincrement())
  task_id    Int?
  action     String
  actor_id   Int?
  actor_name String?
  message    String?
  from_value String?
  to_value   String?
  meta       Json?
  created_at DateTime @default(now())

  task  Task? @relation(fields: [task_id], references: [id], onDelete: SetNull)
  actor User? @relation("TaskLogActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([task_id])
  @@index([created_at])
  @@index([action])
}